# Optional persistent data directory (database and encrypted PDF files)
# CTW_DATA_DIR=./data
# For a public HTTPS installation, configure these via your hosting provider:
# CTW_SECURE_COOKIES=1
# CTW_ALLOWED_ORIGINS=https://tickets.example.com
# CTW_BOOTSTRAP_CODE=replace-with-a-strong-secret-for-remote-first-setup
# CTW_PUBLIC_BASE_URL=https://tickets.example.com
# Legacy watchlist is disabled by default in V4; do not enable it unless intended:
# CTW_ENABLE_LEGACY_WATCHLIST=0

# Optional 'Continue with Google' for invited users (configure only on hosting, never GitHub)
# CTW_GOOGLE_CLIENT_ID=your-web-oauth-client-id.apps.googleusercontent.com
# CTW_GOOGLE_CLIENT_SECRET=your-google-client-secret
# CTW_PUBLIC_BASE_URL=https://your-real-hostname.example
# Google OAuth redirect URI: CTW_PUBLIC_BASE_URL/api/auth/google/callback
