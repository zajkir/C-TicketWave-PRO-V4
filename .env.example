# Set these ONLY in hosting Environment / Secrets, not in GitHub.
CTW_DATA_DIR=/home/container/data
CTW_PUBLIC_BASE_URL=https://YOUR-REAL-DOMAIN
CTW_SECURE_COOKIES=1
CTW_GOOGLE_CLIENT_ID=
CTW_GOOGLE_CLIENT_SECRET=
# Google callback: https://YOUR-REAL-DOMAIN/api/auth/google/callback
# SMTP is needed for registration using email + password and password resets.
CTW_SMTP_HOST=
CTW_SMTP_PORT=587
CTW_SMTP_TLS=starttls
CTW_SMTP_FROM=
CTW_SMTP_USER=
CTW_SMTP_PASSWORD=
# Local automated tests only. Never use this on public hosting:
# CTW_LOCAL_DEV_TOKENS=1

# Ceyrl X Event Radar: users can store their own encrypted key inside the app.
# Optional server fallback if you administer a shared API key:
# CTW_TICKETMASTER_API_KEY=

# Ceyrl GPT-5.4 mini: real AI requires this private server Environment secret.
# Generate a key in https://platform.openai.com/api-keys; do not paste it in chat or commit it.
# CTW_OPENAI_API_KEY=sk-...
# Model is fixed in source to gpt-5.4-mini to avoid expensive accidental overrides.
# Built-in web search uses extra paid tool calls; 1 per answer maximum.
CTW_OPENAI_WEB_SEARCH=1
# Estimated app-side global usage guard in USD; NOT a guaranteed OpenAI billing ceiling.
CTW_OPENAI_MONTHLY_LIMIT_USD=5
# Maximum requests per user/day; 4/minute per account; 30/minute globally.
CTW_OPENAI_USER_DAILY_CALLS=30
# Set a separate API project spend limit in the OpenAI Platform as a billing safeguard.

